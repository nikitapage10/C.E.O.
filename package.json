{
  "name": "ceo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "C.E.O. — Command Everything, Obviously. A live 3D world of AI agents at work, set in the Syntherion Lattice of The Tide.",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ceo/world",
    "build": "npm run build -w @ceo/world",
    "preview": "npm run preview -w @ceo/world",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "world:cast": "node scripts/world-cast.mjs",
    "security:evals": "node scripts/security-evals.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@vercel/blob": "^2.8.1",
    "@vercel/functions": "^3.9.11"
  }
}
