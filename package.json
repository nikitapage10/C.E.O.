{
  "name": "ceo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "C.E.O. — Command Everything, Obviously. A live 3D world of AI agents at work, set in the Syntherion Lattice of The Tide.",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "azure"
  ],
  "scripts": {
    "dev": "npm run dev -w @ceo/world",
    "build": "node scripts/stack-facts.mjs && npm run build -w @ceo/world && npm run build -w @ceo/hub",
    "preview": "npm run preview -w @ceo/world",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "world:cast": "node scripts/world-cast.mjs",
    "stack:facts": "node scripts/stack-facts.mjs",
    "postinstall": "node scripts/stack-facts.mjs --deps",
    "security:evals": "node scripts/security-evals.mjs",
    "build:azure": "node scripts/stack-facts.mjs && npm run build -w @ceo/azure"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.13.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@simplewebauthn/server": "^14.0.3",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.3",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    },
    "undici": "^6.29.1",
    "@azure/msal-node": "^7.1.1"
  }
}
