{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/world/dist",
  "git": { "deploymentEnabled": { "claude/*": false } },
  "github": { "silent": true },
  "functions": { "api/skippy.ts": { "maxDuration": 60 }, "api/world-step.ts": { "maxDuration": 180 }, "api/day-story.ts": { "maxDuration": 150 } },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self'; connect-src 'self' blob: https://api.github.com; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "microphone=(self), camera=(), geolocation=(), payment=(), usb=(), serial=(), magnetometer=(), gyroscope=(), accelerometer=()" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/models/(.*)",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/relay", "destination": "/index.html" },
    { "source": "/foundry", "destination": "/index.html" },
    { "source": "/systems", "destination": "/index.html" },
    { "source": "/systems/security", "destination": "/index.html" },
    { "source": "/systems/compliance", "destination": "/index.html" },
    { "source": "/chronicle", "destination": "/index.html" },
    { "source": "/boiler", "destination": "/index.html" },
    { "source": "/boiler/security", "destination": "/index.html" },
    { "source": "/boiler/compliance", "destination": "/index.html" },
    { "source": "/archive", "destination": "/index.html" },
    { "source": "/spire", "destination": "/index.html" },
    { "source": "/exchange", "destination": "/index.html" },
    { "source": "/green", "destination": "/index.html" },
    { "source": "/workshop", "destination": "/index.html" },
    { "source": "/lattice", "destination": "/index.html" },
    { "source": "/api/site-login", "destination": "/api/desk-auth?site=login" },
    { "source": "/api/site-password", "destination": "/api/desk-auth?site=password" },
    { "source": "/api/exchange-markets", "destination": "/api/world?exchange=markets" },
    { "source": "/api/exchange-positions", "destination": "/api/world?exchange=positions" },
    { "source": "/api/green-league", "destination": "/api/world?green=league" }
  ]
}
