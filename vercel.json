{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/world/dist",
  "git": { "deploymentEnabled": { "claude/*": false } },
  "functions": { "api/world-step.ts": { "maxDuration": 60 } },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/models/(.*)",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/relay", "destination": "/index.html" },
    { "source": "/foundry", "destination": "/index.html" },
    { "source": "/systems", "destination": "/index.html" },
    { "source": "/chronicle", "destination": "/index.html" },
    { "source": "/lattice", "destination": "/index.html" }
  ]
}
